# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NVIDIA open model served by Nebius (hackathon requirement)
REGNAV_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional: Tavily web retrieval for regulation candidates
TAVILY_API_KEY=

# Hard spending guard (live calls beyond these fall back to dry-run)
REGNAV_MAX_CALLS_PER_REVIEW=12
REGNAV_MAX_CALLS_PER_DAY=150
REGNAV_MAX_TOKENS_PER_DAY=400000
